# Server Configuration
PORT=3000
NODE_ENV=production
SITE_URL=https://your-service-name.onrender.com

# OpenRouter AI API Key (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gmail SMTP Configuration for OTP Authentication
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Brevo (formerly Sendinblue) transactional email API
# Free tier: 300 emails/day. Works over HTTPS/443, so it keeps
# working on Render's free tier where outbound SMTP ports are blocked.
# Get your API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com

